NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-frontend.example.com

MONGODB_URI=mongodb+srv://user:password@cluster.example.net/syncup
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_AI_KEY=your-google-ai-key
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

GMAIL_USER=your-email@example.com
GMAIL_PASS=your-app-password
EMAIL_FROM="SyncUp <no-reply@example.com>"

VERIFICATION_HOURS=24
RESET_HOURS=1
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
SIGNUP_WINDOW_MS=3600000
SIGNUP_MAX_ATTEMPTS=10
AUTH_TOKEN_WINDOW_MS=900000
AUTH_TOKEN_MAX_ATTEMPTS=10
RESET_WINDOW_MS=3600000
RESET_MAX_ATTEMPTS=5
