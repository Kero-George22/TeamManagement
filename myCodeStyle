## Coding Conventions — Follow Exactly



### Variable Declarations

```js

const x = ...;  // prefer const

let   y = ...;  // only if reassigned

// NEVER use var

```



### Naming

```js

const myVariable   = ...;   // camelCase for variables and functions

class MyClass      { }      // PascalCase for classes and Mongoose models

const MY_CONSTANT  = ...;   // UPPER_SNAKE_CASE for module-level constants

```



### Error Throwing — always AppError

```js

// CORRECT

throw new AppError('User not found', 404);

throw new AppError('Not authorized', 403);

throw new AppError('Bad input', 400);



// WRONG — never do this

throw new Error('User not found');

res.status(404).json({ message: 'not found' });

```



### Async Handlers — always asyncWrapper

```js

// CORRECT

const myHandler = asyncWrapper(async (req, res) => {

  const result = await myService.doSomething(req.params.id);

  return success(res, result, 'Done');

});



// WRONG

app.get('/thing', async (req, res) => { ... });  // unhandled rejection risk

```



### Responses — always apiResponse helpers

```js

return success(res, data, 'Message');          // 200

return success(res, data, 'Created', 201);     // 201

throw new AppError('Not found', 404);          // errors go through AppError, not res.json

```



### ID Validation — always at start of service functions

```js

async function getItem(id, userId) {

  validateObjectId(id, 'item ID');             // throws 400 if invalid

  const item = await Item.findById(id).lean();

  if (!item) throw new AppError('Item not found', 404);

  ...

}

```



### Mongoose Queries

```js

// Use .lean() for read-only queries (faster, plain JS objects)

const user = await User.findById(id).select('-password').lean();



// Skip .lean() when you need Mongoose methods (.save(), .populate() after modify)

const item = await Item.findById(id);

item.status = 'done';

await item.save();



// Use .select() to only return needed fields

const users = await User.find({}).select('email username avatar').lean();

```



### require() — always at top of file

```js

// CORRECT — at the top

const User = require('../models/user.model');

const asyncWrapper = require('../utils/asyncWrapper');



// WRONG — inside functions

const handler = async (req, res) => {

  const User = require('../models/user.model');  // never do this

};

```



### User input in Regex — always escape

```js

function escapeRegex(str) {

  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

}

const safe = escapeRegex(req.query.search);

Model.find({ name: { $regex: safe, $options: 'i' } });

```



