  return success(res, items, 'Retrieved');

});



exports.create = asyncWrapper(async (req, res) => {

  const { title, description } = req.body;

  if (!title) throw new AppError('Title is required', 400);

  const item = await myService.create({ title, description }, req.user._id);

  return success(res, item, 'Created', 201);

});



exports.delete = asyncWrapper(async (req, res) => {

  await myService.delete(req.params.id, req.user._id, req.user.isAdmin);

  return success(res, null, 'Deleted');

});

