## Service File Pattern

```js

const Model            = require('../models/thing.model');

const AppError         = require('../utils/AppError');

const validateObjectId = require('../utils/validateObjectId');



async function getAll(userId) {

  return Model.find({ owner: userId }).lean();

}



async function create(data, userId) {

  const item = await Model.create({ ...data, owner: userId });

  return item;

}



async function delete(id, userId, isAdmin = false) {

  validateObjectId(id, 'item ID');



  const item = await Model.findById(id);

  if (!item) throw new AppError('Item not found', 404);



  if (!isAdmin && String(item.owner) !== String(userId))

    throw new AppError('Not authorized to delete this item', 403);



  await Model.findByIdAndDelete(id);

  return { ok: true };

}



module.exports = { getAll, create, delete };

```



